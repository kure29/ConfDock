# Optional environment values for a manually launched process. The managed
# systemd unit uses /etc/confdock/config.toml and does not load this file.
# Keep any copy mode 0600. Do not put tokens or configuration contents here.
CONFDOCK_LISTEN=127.0.0.1:8787
CONFDOCK_DATA_DIR=/var/lib/confdock
CONFDOCK_PUBLIC_URL=https://confdock.example.test
CONFDOCK_COOKIE_SECURE=true
CONFDOCK_SESSION_TTL_SECONDS=604800
CONFDOCK_MAX_CONFIG_BYTES=8388608
RUST_LOG=info
