# Copy to /etc/confdock/confdock.env and replace only deployment-specific values.
# Keep this file mode 0600. Do not put tokens or configuration contents here.
CONFDOCK_LISTEN=127.0.0.1:8787
CONFDOCK_DATA_DIR=/var/lib/confdock
CONFDOCK_COOKIE_SECURE=true
CONFDOCK_SESSION_TTL_SECONDS=604800
CONFDOCK_MAX_CONFIG_BYTES=8388608
RUST_LOG=info

# Public URL is persisted in SQLite at first initialization. Set it in
# config.toml before `admin init`, then use the authenticated Settings page.
# CONFDOCK_PUBLIC_URL is only a fallback for a process initializing a new DB.

# Set this only for the first start, then remove it after the administrator is created.
# CONFDOCK_BOOTSTRAP_PASSWORD=replace-with-a-strong-first-run-password
