# Non-secret Compose settings. Keep passwords out of this file.
COMPOSE_PROJECT_NAME=confdock
CONFDOCK_VOLUME_NAME=confdock-data
# The volume is an explicit external resource. Create it once before the
# first config check: docker volume create "$CONFDOCK_VOLUME_NAME"
CONFDOCK_HOST_PORT=8787
CONFDOCK_IMAGE=confdock:local
CONFDOCK_CONFIG_PATH=./config.local.toml

# Set this in the shell for traceability; it is intentionally not a secret.
# CONFDOCK_VCS_REF=
